<Window x:Class="SuperiorAes.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Superior AES Programmer"
        Width="1460"
        Height="900"
        MinWidth="1160"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/Branding/superior-aes.ico"
        Background="{StaticResource CanvasBrush}"
        Closing="Window_Closing">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="238"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Background="{StaticResource NavyDeepBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="132"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="146"/>
            </Grid.RowDefinitions>

            <Grid Margin="18,16,14,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="62"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Image Source="/Assets/Branding/superior-shield.png" Width="55" Height="72" Stretch="Uniform"/>
                <StackPanel Grid.Column="1" Margin="9,4,0,0">
                    <TextBlock Text="SUPERIOR" Foreground="White" FontSize="21" FontWeight="Bold"/>
                    <Border Width="48" Height="4" Background="{StaticResource RedBrush}"
                            HorizontalAlignment="Left" Margin="0,7,0,6"/>
                    <TextBlock Text="AES PROGRAMMER" Foreground="#AFC0D1" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Text="Pete Potempa's AuDHD" Foreground="#FF7180" FontSize="9" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="FIELD WORKSPACE"
                               Foreground="#6F849A"
                               FontSize="10"
                               FontWeight="Bold"
                               Margin="28,6,0,7"/>
                    <Button Style="{StaticResource NavButton}" Tag="0" Click="Navigate_Click" Content="⌂   Dashboard"/>
                    <Button Style="{StaticResource NavButton}" Tag="1" Click="Navigate_Click" Content="⚙   Program subscriber"/>
                    <Button Style="{StaticResource NavButton}" Tag="2" Click="Navigate_Click" Content="◉   Status &amp; routes"/>
                    <Button Style="{StaticResource NavButton}" Tag="3" Click="Navigate_Click" Content="≋   RF monitor"/>
                    <Button Style="{StaticResource NavButton}" Tag="4" Click="Navigate_Click" Content="✚   Troubleshooter"/>
                    <Button Style="{StaticResource NavButton}" Tag="5" Click="Navigate_Click" Content="⌖   Site survey"/>
                    <Button Style="{StaticResource NavButton}" Tag="6" Click="Navigate_Click" Content="⌂   New radio check"/>
                    <Button Style="{StaticResource NavButton}" Tag="7" Click="Navigate_Click" Content="◈   Mesh simulator"/>
                    <Button Style="{StaticResource NavButton}" Tag="11" Click="Navigate_Click" Content="☎   Contact ID capture"/>
                    <Button Style="{StaticResource NavButton}" Tag="8" Click="Navigate_Click" Content="▣   Training guides"/>
                    <Button Style="{StaticResource NavButton}" Tag="9" Click="Navigate_Click" Content="▤   Field report"/>
                    <Button Style="{StaticResource NavButton}" Tag="10" Click="Navigate_Click" Content="›_  Terminal"/>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Margin="15,10,15,18" Padding="13"
                    Background="#122D49" CornerRadius="7">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="ConnectionDot" Width="9" Height="9"
                                 Fill="#75869A" Margin="0,2,8,0"/>
                        <TextBlock x:Name="ConnectionStateText"
                                   Text="Not connected"
                                   Foreground="White"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                    <TextBlock x:Name="ConnectionDetailText"
                               Text="Choose simulation or a COM port"
                               Foreground="#9EB1C4"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="17,5,0,0"/>
                    <TextBlock Text="Brought to you by Pete Potempa's AuDHD"
                               Foreground="#FF7180"
                               FontSize="9"
                               TextWrapping="Wrap"
                               Margin="17,9,0,0"/>
                    <TextBlock Text="v0.4 field engineering build"
                               Foreground="#70859A"
                               FontSize="10"
                               Margin="17,6,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="84"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="0,0,0,1">
                <Grid Margin="24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="PageTitle" Text="Dashboard"
                                   Foreground="{StaticResource NavyBrush}"
                                   FontSize="25"
                                   FontWeight="SemiBold"/>
                        <TextBlock x:Name="PageSubtitle"
                                   Text="Connect, inspect, program, diagnose, and document."
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="12"
                                   Margin="0,3,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Brought to you by Pete Potempa's AuDHD"
                                   HorizontalAlignment="Right"
                                   Foreground="{StaticResource RedBrush}"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,2"/>
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="MODEL"/>
                                <ComboBox x:Name="ModelCombo" Width="98" SelectedIndex="1">
                                    <ComboBoxItem Content="7744F"/>
                                    <ComboBoxItem Content="7788F"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="SERIAL PORT"/>
                                <ComboBox x:Name="PortCombo" Width="118"/>
                            </StackPanel>
                            <Button Style="{StaticResource SecondaryButton}"
                                    Width="42" Height="34" MinHeight="34"
                                    Margin="0,19,8,0" Padding="0"
                                    ToolTip="Refresh serial ports"
                                    Click="RefreshPorts_Click"
                                    Content="↻"/>
                            <CheckBox x:Name="SimulationCheckBox"
                                      IsChecked="True"
                                      VerticalAlignment="Center"
                                      Margin="4,20,12,0"
                                      Content="Simulation"/>
                            <Button x:Name="ConnectButton" Width="105"
                                    Margin="0,19,0,0"
                                    Click="Connect_Click"
                                    Content="Connect"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <TabControl x:Name="WorkspaceTabs"
                        Grid.Row="1"
                        Background="Transparent"
                        BorderThickness="0"
                        SelectedIndex="0">
                <TabItem Style="{StaticResource HiddenTab}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="24,22,12,28">
                            <Border Background="{StaticResource NavyBrush}" CornerRadius="10" Padding="26" Margin="0,0,14,18">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="LEGACY AES, MODERN FIELD WORKFLOW"
                                                   Foreground="#8FB5D8"
                                                   FontSize="11"
                                                   FontWeight="Bold"/>
                                        <TextBlock Text="One cable. One technician workspace."
                                                   Foreground="White"
                                                   FontSize="28"
                                                   FontWeight="SemiBold"
                                                   Margin="0,7,0,5"/>
                                        <TextBlock Text="Use simulation for training, then connect a verified 7043E-compatible USB-to-RS-232 cable for bench and field work."
                                                   Foreground="#CDD9E4"
                                                   FontSize="13"
                                                   TextWrapping="Wrap"
                                                   MaxWidth="720"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#183857" CornerRadius="8" Padding="18,12" Margin="24,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="SERIAL STANDARD" Foreground="#92AFC9" FontSize="10" FontWeight="Bold"/>
                                            <TextBlock Text="4800 · 8-N-1" Foreground="White" FontSize="19" FontWeight="Bold" Margin="0,4,0,0"/>
                                            <TextBlock Text="Flow control OFF" Foreground="#C9D6E1" FontSize="11"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <UniformGrid Columns="6" Margin="0,0,0,4">
                                <Border Style="{StaticResource CardBorder}" Padding="12">
                                    <StackPanel>
                                        <Image Source="/Assets/Hardware/aes-7744f-7788f.png" Height="88" Stretch="Uniform" Cursor="Hand" MouseLeftButtonUp="HardwareImage_Click" Tag="/Assets/Hardware/aes-7744f-7788f.png|AES 7744F fire subscriber|https://aes-corp.com/product/7788f-fire-subscriber/"/>
                                        <TextBlock Text="7744F" FontWeight="Bold" Foreground="{StaticResource NavyBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="4×4 fire subscriber" FontSize="10" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardBorder}" Padding="12">
                                    <StackPanel>
                                        <Image Source="/Assets/Hardware/aes-7744f-7788f.png" Height="88" Stretch="Uniform" Cursor="Hand" MouseLeftButtonUp="HardwareImage_Click" Tag="/Assets/Hardware/aes-7744f-7788f.png|AES 7788F fire subscriber|https://aes-corp.com/product/7788f-fire-subscriber/"/>
                                        <TextBlock Text="7788F" FontWeight="Bold" Foreground="{StaticResource NavyBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="8-zone fire subscriber" FontSize="10" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardBorder}" Padding="12">
                                    <StackPanel>
                                        <Image Source="/Assets/Hardware/aes-7214-rubber-duck.png" Height="88" Stretch="Uniform" Cursor="Hand" MouseLeftButtonUp="HardwareImage_Click" Tag="/Assets/Hardware/aes-7214-rubber-duck.png|AES 7214 2.5 dB antenna|https://aes-corp.com/product/7214-2-5-omnidirectional-rubber-duck-antenna/"/>
                                        <TextBlock Text="7214 · 2.5 dB" FontWeight="Bold" Foreground="{StaticResource NavyBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardBorder}" Padding="12">
                                    <StackPanel>
                                        <Image Source="/Assets/Hardware/aes-7211-stealth.png" Height="88" Stretch="Uniform" Cursor="Hand" MouseLeftButtonUp="HardwareImage_Click" Tag="/Assets/Hardware/aes-7211-stealth.png|AES 7211 3 dB stealth antenna|https://aes-corp.com/product/7211-3-db-omnidirectional-stealth-antenna/"/>
                                        <TextBlock Text="7211 · 3 dB" FontWeight="Bold" Foreground="{StaticResource NavyBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardBorder}" Padding="12">
                                    <StackPanel>
                                        <Image Source="/Assets/Hardware/aes-7210-5.png" Height="88" Stretch="Uniform" Cursor="Hand" MouseLeftButtonUp="HardwareImage_Click" Tag="/Assets/Hardware/aes-7210-5.png|AES 7210-5 5 dB antenna|https://aes-corp.com/product/7210-5-5db-omnidirectional-antenna/"/>
                                        <TextBlock Text="7210-5 · 5 dB" FontWeight="Bold" Foreground="{StaticResource NavyBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardBorder}" Padding="12">
                                    <StackPanel>
                                        <Image Source="/Assets/Hardware/aes-7210-6.png" Height="88" Stretch="Uniform" Cursor="Hand" MouseLeftButtonUp="HardwareImage_Click" Tag="/Assets/Hardware/aes-7210-6.png|AES 7210-6 6 dB antenna|https://aes-corp.com/product/7210-6-6db-omnidirectional-antenna/"/>
                                        <TextBlock Text="7210-6 · 6 dB" FontWeight="Bold" Foreground="{StaticResource NavyBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <UniformGrid Columns="5" Margin="0,0,0,4">
                                <Border Style="{StaticResource CardBorder}" Padding="12">
                                    <StackPanel>
                                        <Image Source="/Assets/Hardware/aes-7210-3.png" Height="88" Stretch="Uniform" Cursor="Hand" MouseLeftButtonUp="HardwareImage_Click" Tag="/Assets/Hardware/aes-7210-3.png|AES 7210-3 3 dB antenna|https://aes-corp.com/product/7210-3-3db-omnidirectional-antenna/"/>
                                        <TextBlock Text="7210-3 · 3 dB" FontWeight="Bold" Foreground="{StaticResource NavyBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardBorder}" Padding="12">
                                    <StackPanel>
                                        <Image Source="/Assets/Hardware/aes-7210-7.jpg" Height="88" Stretch="Uniform" Cursor="Hand" MouseLeftButtonUp="HardwareImage_Click" Tag="/Assets/Hardware/aes-7210-7.jpg|AES 7210-7 7 dB antenna|https://aes-corp.com/product/7210-7-7db-omnidirectional-antenna/"/>
                                        <TextBlock Text="7210-7 · 7 dB" FontWeight="Bold" Foreground="{StaticResource NavyBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardBorder}" Padding="12">
                                    <StackPanel>
                                        <Image Source="/Assets/Hardware/aes-7210-9.jpg" Height="88" Stretch="Uniform" Cursor="Hand" MouseLeftButtonUp="HardwareImage_Click" Tag="/Assets/Hardware/aes-7210-9.jpg|AES 7210-9 9 dB antenna|https://aes-corp.com/product/7210-9-9db-omnidirectional-antenna/"/>
                                        <TextBlock Text="7210-9 · 9 dB" FontWeight="Bold" Foreground="{StaticResource NavyBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardBorder}" Padding="12">
                                    <StackPanel>
                                        <Image Source="/Assets/Hardware/aes-7794-intellipro.jpg" Height="88" Stretch="Uniform" Cursor="Hand" MouseLeftButtonUp="HardwareImage_Click" Tag="/Assets/Hardware/aes-7794-intellipro.jpg|AES 7794 IntelliPro Fire|https://aes-corp.com/product/7794-subscriber-add-on-module/"/>
                                        <TextBlock Text="7794 IntelliPro" FontWeight="Bold" Foreground="{StaticResource NavyBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardBorder}" Padding="12">
                                    <StackPanel>
                                        <Image Source="/Assets/Hardware/aes-7794a-intellipro.png" Height="88" Stretch="Uniform" Cursor="Hand" MouseLeftButtonUp="HardwareImage_Click" Tag="/Assets/Hardware/aes-7794a-intellipro.png|AES 7794A IntelliPro 2.0|https://aes-corp.com/product/7794a-accessory-board/"/>
                                        <TextBlock Text="7794A · 2.0 only" FontWeight="Bold" Foreground="{StaticResource NavyBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <UniformGrid Columns="4">
                                <Border Style="{StaticResource CardBorder}">
                                    <StackPanel>
                                        <TextBlock Text="CONNECTION" Style="{StaticResource FieldLabel}"/>
                                        <TextBlock x:Name="DashboardConnectionValue" Text="Offline" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource NavyBrush}"/>
                                        <TextBlock Text="Simulation or verified serial adapter" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardBorder}">
                                    <StackPanel>
                                        <TextBlock Text="SUBSCRIBER" Style="{StaticResource FieldLabel}"/>
                                        <TextBlock x:Name="DashboardSubscriberValue" Text="Not read" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource NavyBrush}"/>
                                        <TextBlock x:Name="DashboardModelValue" Text="7744F / 7788F" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardBorder}">
                                    <StackPanel>
                                        <TextBlock Text="NETWORK" Style="{StaticResource FieldLabel}"/>
                                        <TextBlock x:Name="DashboardNetconValue" Text="NETCON —" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource NavyBrush}"/>
                                        <TextBlock x:Name="DashboardRouteValue" Text="No route data" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardBorder}">
                                    <StackPanel>
                                        <TextBlock Text="SELF TEST" Style="{StaticResource FieldLabel}"/>
                                        <TextBlock x:Name="DashboardStatValue" Text="STAT —" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource NavyBrush}"/>
                                        <TextBlock Text="Decoded in Troubleshooter" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.6*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource CardBorder}">
                                    <StackPanel>
                                        <TextBlock Text="Quick field sequence" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Text="1  Put the account on test and connect the verified programming cable." Margin="0,4"/>
                                        <TextBlock Text="2  Read Local Status, Routing Table, and Zone Status." Margin="0,4"/>
                                        <TextBlock Text="3  Run the guided troubleshooter before changing hardware." Margin="0,4"/>
                                        <TextBlock Text="4  Program only the required values; reset the board after zone changes." Margin="0,4"/>
                                        <TextBlock Text="5  Confirm every alarm, trouble, supervisory, and restoral at central station." Margin="0,4"/>
                                        <WrapPanel Margin="0,18,0,0">
                                            <Button Tag="LocalStatus" Click="Command_Click" Content="Read local status" Margin="0,0,8,0"/>
                                            <Button Tag="RoutingTable" Click="Command_Click" Content="Read routes" Margin="0,0,8,0"/>
                                            <Button Tag="ZoneStatus" Click="Command_Click" Content="Read zones"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource CardBorder}">
                                    <StackPanel>
                                        <TextBlock Text="Safety gates" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Text="✓  RF keying requires a load/antenna confirmation." Margin="0,5" TextWrapping="Wrap"/>
                                        <TextBlock Text="✓  RAM reset requires a typed confirmation and warning." Margin="0,5" TextWrapping="Wrap"/>
                                        <TextBlock Text="✓  Monitor All automatically requires RX Monitor." Margin="0,5" TextWrapping="Wrap"/>
                                        <TextBlock Text="✓  UL fire defaults and range warnings are built in." Margin="0,5" TextWrapping="Wrap"/>
                                        <TextBlock Text="Bench-validate direct serial functions before field deployment."
                                                   Foreground="{StaticResource RedBrush}"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap"
                                                   Margin="0,15,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Style="{StaticResource HiddenTab}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="24,22,12,28">
                            <Border Style="{StaticResource CardBorder}" Background="#F7FAFC">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.25*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="1.25*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Programming template" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="ProgrammingTemplateCombo" DisplayMemberPath="Name"/>
                                        <TextBlock Text="Templates never store the system cipher." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,6,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="TEMPLATE NAME" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="TemplateNameTextBox" Text="My fire template"/>
                                        <WrapPanel Margin="0,8,0,0">
                                            <Button Content="Save current" Click="SaveTemplate_Click" Margin="0,0,8,0"/>
                                            <Button Content="Apply" Click="ApplyTemplate_Click" Style="{StaticResource SecondaryButton}"/>
                                            <Button Content="Import" Click="ImportTemplates_Click" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"/>
                                            <Button Content="Export" Click="ExportTemplates_Click" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"/>
                                        </WrapPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="PLANNED ANTENNA" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="ProgrammingAntennaCombo" DisplayMemberPath="DisplayName"/>
                                        <TextBlock Text="CONTACT ID / DIALER CAPTURE" Style="{StaticResource FieldLabel}" Margin="0,10,0,5"/>
                                        <ComboBox x:Name="ProgrammingDialerCaptureCombo" SelectedIndex="0" SelectionChanged="ProgrammingDialerCaptureCombo_SelectionChanged">
                                            <ComboBoxItem Content="None"/>
                                            <ComboBoxItem Content="7794 IntelliPro Fire (recommended)"/>
                                            <ComboBoxItem Content="7067 IntelliTap II (legacy / discontinued)"/>
                                            <ComboBoxItem Content="7794A IntelliPro (2.0 Fire only)"/>
                                        </ComboBox>
                                        <WrapPanel Margin="0,8,0,0">
                                            <Button Content="Open Contact ID" Tag="11" Click="Navigate_Click"/>
                                            <Button Content="Delete template" Click="DeleteTemplate_Click" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="Template notes" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="Fully editable job instructions, verification steps, or site conventions. Never enter a cipher or API key here." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    <TextBox x:Name="TemplateNotesTextBox" AcceptsReturn="True" MinHeight="72" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <Border Style="{StaticResource CardBorder}">
                                        <StackPanel>
                                            <TextBlock Text="Subscriber ID &amp; system cipher" Style="{StaticResource SectionTitle}"/>
                                            <TextBlock Text="Both values are four uppercase hexadecimal characters. Leave cipher blank to preserve the existing cipher." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="14"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="SUBSCRIBER ID" Style="{StaticResource FieldLabel}"/>
                                                    <TextBox x:Name="SubscriberIdTextBox" MaxLength="4" CharacterCasing="Upper" Text="1A2B"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="SYSTEM CIPHER" Style="{StaticResource FieldLabel}"/>
                                                    <TextBox x:Name="CipherTextBox" MaxLength="4" CharacterCasing="Upper"/>
                                                </StackPanel>
                                            </Grid>
                                            <Button Content="Program ID and cipher" HorizontalAlignment="Left" Margin="0,16,0,0" Click="ProgramIdentity_Click"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource CardBorder}">
                                        <StackPanel>
                                            <TextBlock Text="Check-in &amp; reporting timers" Style="{StaticResource SectionTitle}"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="CHECK-IN HOURS" Style="{StaticResource FieldLabel}"/>
                                                    <TextBox x:Name="CheckHoursTextBox" Text="24"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="CHECK-IN MINUTES" Style="{StaticResource FieldLabel}"/>
                                                    <TextBox x:Name="CheckMinutesTextBox" Text="00"/>
                                                </StackPanel>
                                            </Grid>
                                            <Grid Margin="0,12,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="AC REPORT DELAY (RM OR 0–60)" Style="{StaticResource FieldLabel}"/>
                                                    <TextBox x:Name="AcDelayTextBox" Text="RM" CharacterCasing="Upper"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="REPORT DELAY SEC (UL FIRE 10–20)" Style="{StaticResource FieldLabel}"/>
                                                    <TextBox x:Name="ReportDelayTextBox" Text="10"/>
                                                </StackPanel>
                                            </Grid>
                                            <Button Content="Program timers" HorizontalAlignment="Left" Margin="0,16,0,0" Click="ProgramTimers_Click"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <Border Style="{StaticResource CardBorder}">
                                        <StackPanel>
                                            <TextBlock Text="Zones &amp; restorals" Style="{StaticResource SectionTitle}"/>
                                            <TextBlock Text="Exactly eight characters, left to right for Zones 1–8. Reset the physical board after changing zone programming." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,14"/>
