                                                <Button Content="F4 · Up" Tag="F4" Click="ContactIdControl_Click" Margin="0,0,8,8"/>
                                                <Button Content="F5 · Down" Tag="F5" Click="ContactIdControl_Click" Margin="0,0,8,8"/>
                                                <Button Content="ESC · Exit" Tag="ESC" Click="ContactIdControl_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"/>
                                            </WrapPanel>
                                            <TextBox x:Name="ContactIdTerminalPreview"
                                                     IsReadOnly="True"
                                                     AcceptsReturn="True"
                                                     TextWrapping="NoWrap"
                                                     VerticalScrollBarVisibility="Auto"
                                                     HorizontalScrollBarVisibility="Auto"
                                                     Height="170"
                                                     Background="#0B141D"
                                                     Foreground="#D1F5E5"
                                                     BorderThickness="0"
                                                     Padding="12"
                                                     FontFamily="Consolas"
                                                     FontSize="14"
                                                     Margin="0,4,0,0"/>
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="ContactIdTerminalInputTextBox"
                                                         FontFamily="Consolas"
                                                         KeyDown="ContactIdTerminalInput_KeyDown"/>
                                                <Button Grid.Column="1"
                                                        Content="Send response"
                                                        Click="SendContactIdLine_Click"
                                                        Margin="8,0,0,0"/>
                                            </Grid>
                                            <TextBlock Text="Direct 7794 PC-terminal operation still requires physical bench validation with known-good 7744F and 7788F hardware before field deployment."
                                                       Foreground="{StaticResource RedBrush}"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="Guides, original manuals, and official AES pages" Style="{StaticResource SectionTitle}"/>
                                    <WrapPanel>
                                        <Button Content="Open field guide"
                                                Tag="Superior-AES-Contact-ID-IntelliPro-IntelliTap-Field-Guide.pdf"
                                                Click="OpenBundledTraining_Click"
                                                Margin="0,0,8,8"/>
                                        <Button Content="7794 installation manual"
                                                Tag="AES-7794-IntelliPro-Fire-Installation-Manual.pdf"
                                                Click="OpenBundledTraining_Click"
                                                Style="{StaticResource SecondaryButton}"
                                                Margin="0,0,8,8"/>
                                        <Button Content="7794 quick start"
                                                Tag="AES-7794-IntelliPro-Quick-Start-Guide.pdf"
                                                Click="OpenBundledTraining_Click"
                                                Style="{StaticResource SecondaryButton}"
                                                Margin="0,0,8,8"/>
                                        <Button Content="7794A 2.0 manual"
                                                Tag="AES-7794A-IntelliPro-2.0-Installation-Manual.pdf"
                                                Click="OpenBundledTraining_Click"
                                                Style="{StaticResource SecondaryButton}"
                                                Margin="0,0,8,8"/>
                                        <Button Content="Browse in Training"
                                                Click="OpenContactIdTraining_Click"
                                                Style="{StaticResource SecondaryButton}"
                                                Margin="0,0,8,8"/>
                                        <Button Content="Official 7794 product page"
                                                Tag="https://aes-corp.com/product/7794-subscriber-add-on-module/"
                                                Click="OpenOfficialPage_Click"
                                                Style="{StaticResource SecondaryButton}"
                                                Margin="0,0,8,8"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <Border Grid.Row="2" Background="#E9EEF2" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="13,0">
                    <TextBlock x:Name="StatusBarText" Text="Ready — use Simulation for safe training without a connected subscriber."
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="11"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="J1 PIN 6 (+12 V): DO NOT CONNECT"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource RedBrush}"
                               FontSize="10"
                               FontWeight="Bold"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
