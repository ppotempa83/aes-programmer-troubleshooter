<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>AesProgrammer.Troubleshooter</AssemblyName>
    <RootNamespace>SuperiorAes.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Branding\superior-aes.ico</ApplicationIcon>
    <Version>0.5.0</Version>
    <Authors>AES Programmer Project</Authors>
    <Product>AES Programmer &amp; Troubleshooter</Product>
    <Description>Field programming and diagnostic utility for legacy AES 7744F and 7788F subscribers.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SuperiorAes.Core\SuperiorAes.Core.csproj" />
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\Hardware\*.png" />
    <Resource Include="Assets\Hardware\*.jpg" />
    <Resource Include="Assets\Branding\*.png" />
    <Resource Include="Assets\Branding\*.ico" />
    <Resource Include="Assets\Training\*-cover.png" />
    <Content Include="Assets\Training\*.pdf"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             ExcludeFromSingleFile="true" />
    <Content Include="Assets\Training\*.txt"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             ExcludeFromSingleFile="true" />
  </ItemGroup>
</Project>
