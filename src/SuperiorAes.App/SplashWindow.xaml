<Window x:Class="SuperiorAes.App.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AES Programmer &amp; Troubleshooter"
        Width="700"
        Height="470"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/Branding/superior-aes.ico">
    <Border Background="#091A2C"
            BorderBrush="#C5202F"
            BorderThickness="3"
            CornerRadius="24"
            Padding="34">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Image Source="/Assets/Branding/superior-aes-icon.png"
                   Stretch="Uniform"
                   Margin="30,0"/>
            <TextBlock Grid.Row="1"
                       Text="AES PROGRAMMER &amp; TROUBLESHOOTER"
                       Foreground="White"
                       FontSize="27"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,14,0,0"/>
            <ProgressBar Grid.Row="3"
                         IsIndeterminate="True"
                         Height="5"
                         Background="#183857"
                         Foreground="#C5202F"
                         BorderThickness="0"
                         Margin="80,24,80,0"/>
        </Grid>
    </Border>
</Window>
