<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>SuperiorAes.Android</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <ApplicationTitle>Superior AES Programmer</ApplicationTitle>
    <ApplicationId>com.superiorfirellc.superioraesprogrammer</ApplicationId>
    <ApplicationDisplayVersion>0.1.1</ApplicationDisplayVersion>
    <ApplicationVersion>2</ApplicationVersion>

    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <!-- Debug APKs are shared with technicians for device trials, so they must
         run without Visual Studio/.NET fast-deployment files on the phone. -->
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <AndroidUseFastDeployment>false</AndroidUseFastDeployment>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="..\..\..\src\SuperiorAes.App\Assets\Branding\superior-shield.png"
              Link="Resources\AppIcon\appshield.png"
              Color="#0A192A"
              BaseSize="1024,1024" />
    <MauiSplashScreen Include="Resources\Splash\superior_shield.png"
                      Color="#0A192A"
                      BaseSize="512,512" />
    <MauiImage Include="Resources\Images\*" />
    <MauiAsset Include="Resources\Raw\**"
               LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    <MauiImage Include="..\..\..\src\SuperiorAes.App\Assets\Branding\superior-shield.png"
               Link="Resources\Images\superior_shield.png" />
    <MauiAsset Include="..\..\..\src\SuperiorAes.App\Assets\Hardware\*.*"
               LogicalName="Hardware/%(Filename)%(Extension)" />
    <MauiAsset Include="..\..\..\src\SuperiorAes.App\Assets\Training\*.pdf"
               LogicalName="Training/%(Filename)%(Extension)" />
    <MauiAsset Include="..\..\..\src\SuperiorAes.App\Assets\Training\*.txt"
               LogicalName="Training/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <ProjectReference Include="..\..\..\src\SuperiorAes.Core\SuperiorAes.Core.csproj" />
  </ItemGroup>
</Project>
