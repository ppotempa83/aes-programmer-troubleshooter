<?xml version="1.0" encoding="utf-8"?>
<ContentPage
    x:Class="SuperiorAes.Android.Pages.TerminalPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:SuperiorAes.Android.Controls"
    Title="Terminal">
  <Grid Padding="20" RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" RowSpacing="12">
    <Label Grid.Row="0" Text="Timestamped terminal" Style="{StaticResource PageTitle}" />
    <Label
        Grid.Row="1"
        Text="Every RX, TX, app, and activity line uses [MM-DD-YYYY / HH:MM (AM/PM)]. API keys and cipher values are redacted and excluded from exports."
        Style="{StaticResource MutedText}" />
    <Border
        Grid.Row="2"
        Padding="10,7"
        BackgroundColor="#FFF1F2"
        Stroke="#F3A7AF"
        StrokeShape="RoundRectangle 8">
      <Label
          Text="DIRECT TERMINAL · SELECTED TRANSPORT"
          FontAttributes="Bold"
          HorizontalTextAlignment="Center"
          TextColor="{StaticResource BrandRed}" />
    </Border>
    <Border
        Grid.Row="3"
        Padding="12"
        BackgroundColor="#101820"
        StrokeThickness="0"
        StrokeShape="RoundRectangle 8">
      <ScrollView>
        <Label
            x:Name="TerminalOutputLabel"
            FontFamily="monospace"
            FontSize="12"
            TextColor="#D7F4E8" />
      </ScrollView>
    </Border>
    <Grid Grid.Row="4" ColumnDefinitions="*,Auto" ColumnSpacing="8">
      <Entry
          x:Name="TerminalEntry"
          Grid.Column="0"
          Completed="OnSendClicked"
          Placeholder="Enter terminal response" />
      <HorizontalStackLayout Grid.Column="1" Spacing="6">
        <Button Clicked="OnSendClicked" Text="Send" />
        <Button Clicked="OnEnterClicked" Style="{StaticResource SecondaryButton}" Text="ENTER" />
      </HorizontalStackLayout>
    </Grid>
    <controls:BrandFooterView Grid.Row="5" />
  </Grid>
</ContentPage>
