<?xml version="1.0" encoding="utf-8"?>
<ContentPage
    x:Class="SuperiorAes.Android.Pages.ConfigurationPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:SuperiorAes.Android.Controls"
    xmlns:services="clr-namespace:SuperiorAes.Android.Services"
    Title="Configuration">
  <ScrollView>
    <VerticalStackLayout Padding="20" Spacing="14">
      <Label Text="Configuration" Style="{StaticResource PageTitle}" />
      <Label
          Text="Set the technician label and review external-service setup and FTDI safety information."
          Style="{StaticResource MutedText}" />

      <Border Style="{StaticResource Card}">
        <VerticalStackLayout Spacing="10">
          <Label Text="Session metadata" Style="{StaticResource SectionTitle}" />
          <Entry x:Name="TechnicianEntry" Placeholder="Technician / Android profile label" />
          <Button Clicked="OnSaveMetadataClicked" Text="Save session label" />
        </VerticalStackLayout>
      </Border>

      <Border Style="{StaticResource Card}">
        <VerticalStackLayout Spacing="10">
          <Label Text="Geoapify setup" Style="{StaticResource SectionTitle}" />
          <Label
              Text="No API key or credential file is bundled with this app. Register or sign in at Geoapify MyProjects, create a project, open API Keys, then copy the generated key into Site survey &amp; new radio."
              Style="{StaticResource MutedText}" />
          <Button Clicked="OnOpenGeoapifyClicked" Style="{StaticResource SecondaryButton}" Text="Open Geoapify MyProjects" />
          <Label x:Name="ImportStatusLabel" Style="{StaticResource MutedText}" />
        </VerticalStackLayout>
      </Border>

      <Border Padding="16" BackgroundColor="#FFF1F2" Stroke="#F3A7AF" StrokeShape="RoundRectangle 10">
        <VerticalStackLayout Spacing="6">
          <Label Text="Security boundary" FontAttributes="Bold" TextColor="{StaticResource BrandRed}" />
          <Label
              Text="User-supplied Geoapify keys are never printed to logs, reports, or exports. An APK cannot make a client-side key unrecoverable from a determined device owner; use a server-side proxy when true key secrecy is required."
              FontSize="13"
              TextColor="#8F1420" />
        </VerticalStackLayout>
      </Border>

      <Border Padding="16" BackgroundColor="#FFF8E8" Stroke="#E8C46D" StrokeShape="RoundRectangle 10">
        <VerticalStackLayout Spacing="6">
          <Label Text="Android FTDI connection" FontAttributes="Bold" TextColor="#775500" />
          <Label
              Text="{x:Static services:FtdiD2xxTransportRequirements.IntegrationStatus}"
              FontSize="13"
              TextColor="#775500" />
          <Label
              Text="Physical use additionally requires a genuine FTDI USB-to-RS-232 adapter, USB Host/OTG support, isolated J1 pin 6 (+12 V), and retained known-good-radio bench results."
              FontSize="13"
              TextColor="#775500" />
        </VerticalStackLayout>
      </Border>
      <controls:BrandFooterView />
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
