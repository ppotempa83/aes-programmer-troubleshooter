<?xml version="1.0" encoding="utf-8"?>
<ContentPage
    x:Class="SuperiorAes.Android.Pages.ConfigurationPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:SuperiorAes.Android.Controls"
    xmlns:services="clr-namespace:SuperiorAes.Android.Services"
    Title="Configuration">
  <ScrollView>
    <VerticalStackLayout Padding="20" Spacing="14">
      <Label Text="Configuration" Style="{StaticResource PageTitle}" />
      <Label
          Text="Import a technician-edited key/value file and migrate populated values into Android Secure Storage. The plaintext file remains under the distributor's control."
          Style="{StaticResource MutedText}" />

      <Border Style="{StaticResource Card}">
        <VerticalStackLayout Spacing="10">
          <Label Text="Session metadata" Style="{StaticResource SectionTitle}" />
          <Entry x:Name="TechnicianEntry" Placeholder="Technician / Android profile label" />
          <Button Clicked="OnSaveMetadataClicked" Text="Save session label" />
        </VerticalStackLayout>
      </Border>

      <Border Style="{StaticResource Card}">
        <VerticalStackLayout Spacing="10">
          <Label Text="Editable distribution-file format" Style="{StaticResource SectionTitle}" />
          <Label
              Text="Android APKs are signed and immutable: a populated file cannot remain editable beside or inside the APK. Distribute credentials.local.txt as a separate file and import it once with Android's file picker. Managed provisioning may instead stage that exact filename in the app-private path below; startup migrates it to Secure Storage and removes the plaintext staging copy."
              Style="{StaticResource MutedText}" />
          <Label
              x:Name="AutomaticPathLabel"
              FontFamily="monospace"
              FontSize="11"
              TextColor="#68788B" />
          <Editor
              x:Name="CredentialTemplateEditor"
              IsReadOnly="True"
              FontFamily="monospace"
              FontSize="13"
              HeightRequest="180"
              Text="GeoapifyApiKey=***&#10;Company1ApiKey=***&#10;Company2ApiKey=***&#10;CompanyPasscode=***" />
          <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
            <Button Grid.Row="0" Grid.Column="0" Clicked="OnCopyTemplateClicked" Text="Copy template" />
            <Button Grid.Row="0" Grid.Column="1" Clicked="OnShareTemplateClicked" Style="{StaticResource SecondaryButton}" Text="Share blank template" />
            <Button Grid.Row="1" Grid.ColumnSpan="2" Clicked="OnImportCredentialsClicked" Style="{StaticResource SecondaryButton}" Text="Import populated credential file" />
          </Grid>
          <Label x:Name="ImportStatusLabel" Style="{StaticResource MutedText}" />
        </VerticalStackLayout>
      </Border>

      <Border Padding="16" BackgroundColor="#FFF1F2" Stroke="#F3A7AF" StrokeShape="RoundRectangle 10">
        <VerticalStackLayout Spacing="6">
          <Label Text="Security boundary" FontAttributes="Bold" TextColor="{StaticResource BrandRed}" />
          <Label
              Text="Values are never printed back to this page, logs, reports, or exports. An APK cannot make a client-side key unrecoverable from a determined device owner; use a server-side proxy when true key secrecy is required."
              FontSize="13"
              TextColor="#8F1420" />
        </VerticalStackLayout>
      </Border>

      <Border Padding="16" BackgroundColor="#FFF8E8" Stroke="#E8C46D" StrokeShape="RoundRectangle 10">
        <VerticalStackLayout Spacing="6">
          <Label Text="Android FTDI connection" FontAttributes="Bold" TextColor="#775500" />
          <Label
              Text="{x:Static services:FtdiD2xxTransportRequirements.IntegrationStatus}"
              FontSize="13"
              TextColor="#775500" />
          <Label
              Text="Physical use additionally requires a genuine FTDI USB-to-RS-232 adapter, USB Host/OTG support, isolated J1 pin 6 (+12 V), and retained known-good-radio bench results."
              FontSize="13"
              TextColor="#775500" />
        </VerticalStackLayout>
      </Border>
      <controls:BrandFooterView />
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
