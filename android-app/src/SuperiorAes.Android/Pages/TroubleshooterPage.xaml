<?xml version="1.0" encoding="utf-8"?>
<ContentPage
    x:Class="SuperiorAes.Android.Pages.TroubleshooterPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:SuperiorAes.Android.Controls"
    Title="Troubleshooter">
  <ScrollView>
    <VerticalStackLayout Padding="20" Spacing="14">
      <Label Text="Guided troubleshooter" Style="{StaticResource PageTitle}" />
      <Label
          Text="Captures local status, the full routing table, zone state, associated-radio L/N/Q values, visual path text, findings, and prioritized recommendations."
          Style="{StaticResource MutedText}" />
      <Button Clicked="OnBaselineClicked" Text="Run live read-only baseline" />
      <Border Style="{StaticResource Card}">
        <VerticalStackLayout Spacing="8">
          <Label Text="Emergency24 AES map evidence" Style="{StaticResource SectionTitle}" />
          <Label
              Text="Coordinates load all public AES antenna layers without a Geoapify key. Map evidence is a troubleshooting variable, not a field measurement."
              Style="{StaticResource MutedText}" />
          <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
            <Entry x:Name="CoverageLatitudeEntry" Grid.Column="0" Keyboard="Numeric" Placeholder="Latitude" />
            <Entry x:Name="CoverageLongitudeEntry" Grid.Column="1" Keyboard="Numeric" Placeholder="Longitude" />
          </Grid>
          <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
            <Button Grid.Column="0" Clicked="OnCoverageClicked" Text="Load antenna layers" />
            <Button Grid.Column="1" Clicked="OnOpenAesMapClicked" Style="{StaticResource SecondaryButton}" Text="Open AES map" />
          </Grid>
          <Label
              x:Name="CoverageEvidenceLabel"
              Text="No Emergency24 evidence loaded."
              FontFamily="monospace"
              FontSize="12"
              LineBreakMode="WordWrap" />
        </VerticalStackLayout>
      </Border>
      <Border Style="{StaticResource Card}">
        <VerticalStackLayout Spacing="8">
          <Label Text="Assessment and visualized path" Style="{StaticResource SectionTitle}" />
          <Label x:Name="AssessmentLabel" Text="Run the baseline to populate findings." FontFamily="monospace" FontSize="12" />
        </VerticalStackLayout>
      </Border>
      <Border Style="{StaticResource Card}">
        <VerticalStackLayout Spacing="8">
          <Label Text="Troubleshooting-only export metadata" Style="{StaticResource SectionTitle}" />
          <Entry x:Name="SiteEntry" Placeholder="Site name" />
          <Entry x:Name="AccountEntry" Placeholder="Account / work order" />
          <Entry x:Name="TechnicianEntry" Placeholder="Technician" />
          <Button Clicked="OnExportClicked" Style="{StaticResource SecondaryButton}" Text="Export &amp; share troubleshooting HTML" />
        </VerticalStackLayout>
      </Border>
      <Label
          Text="The focused export excludes the general terminal dump, credentials, and cipher. It includes subscriber/routing evidence, a visual path, associated-radio values, retained Emergency24 site evidence, findings, and recommendations."
          Style="{StaticResource MutedText}" />
      <controls:BrandFooterView />
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
